# Database
# For local development with SQLite (change provider in schema.prisma to "sqlite"):
# DATABASE_URL="file:./prisma/dev.db"

# For production with PostgreSQL (Render, Neon, Supabase, etc.):
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# JWT
JWT_SECRET="your-secret-key-change-in-production-use-long-random-string"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV="development"

# CORS - Frontend URL (change for production)
FRONTEND_URL="http://localhost:8080"

# SMTP (for reservation confirmation emails when status -> confirmed)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
# MAIL_FROM=noreply@weidaojia.de
